<Project>

  <!--
    Isolates SimulaSharp.Studio from the framework repo's root Directory.Build.props (which carries the
    package Version, metadata, LICENSE packing, snupkg, etc.). MSBuild imports only the *nearest*
    Directory.Build.props walking up, so this file stops the walk before the repo root — Studio is a tool,
    not a packed framework artifact.
  -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!--
    MSBuildWorkspace: the Microsoft.Build.* assemblies that Microsoft.CodeAnalysis.Workspaces.MSBuild drags in
    must be loaded from the installed .NET SDK by MSBuildLocator at run time, NOT copied from the NuGet package
    (they clash otherwise — MSBL001). Excluding their runtime assets here covers Core and everything that
    references it (Host, Tests) transitively.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" Version="17.11.48" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>

