<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    A small consumer simulation: real user models/services/interface using the current decorators, with the
    generated members supplied by the CodeGen analyzer. Serves as a Studio test fixture (and the thing the
    editors are grown against). References the framework by ProjectReference so it builds in-repo.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\Kernel\Kernel.csproj" />
    <ProjectReference Include="..\..\..\CodeGen\SimulaSharp.CodeGen.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- SimAssembly items must precede the targets import so @(SimAssembly) is populated when it maps to AdditionalFiles
       (a NuGet consumer gets the import automatically, after the project body). -->
  <ItemGroup>
    <SimAssembly Include="DemoSim.simassembly.yaml" />
  </ItemGroup>
  <Import Project="..\..\..\CodeGen\build\SimulaSharp.CodeGen.targets" />

</Project>
