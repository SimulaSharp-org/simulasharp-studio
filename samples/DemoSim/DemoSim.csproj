<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!--
    A small consumer simulation: real user models/services/interface using the current decorators, with the
    generated members supplied by the CodeGen analyzer. Serves as a Studio test fixture (and the thing the
    editors are grown against). References the framework as the SimulaSharp NuGet package, like any consumer;
    until it is on nuget.org, a local (uncommitted) nuget.config points restore at a local feed.
  -->
  <ItemGroup>
    <PackageReference Include="SimulaSharp" Version="0.5.3" />
  </ItemGroup>

  <!-- The package's targets are imported automatically after the project body, so @(SimAssembly) is populated
       by the time they map it to AdditionalFiles. -->
  <ItemGroup>
    <SimAssembly Include="DemoSim.simassembly.yaml" />
  </ItemGroup>

</Project>
