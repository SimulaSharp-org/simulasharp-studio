<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <!-- In-process ASP.NET Core (Kestrel + SignalR); Photino opens a native webview on it. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SimulaSharp.Studio.Core\SimulaSharp.Studio.Core.csproj" />
  </ItemGroup>

  <!-- Copy the built Vite SPA (Studio/web/dist) into the Host output's wwwroot so it's served same-origin.
       Build the web app first: `cd Studio/web && npm run build`. -->
  <Target Name="CopyStudioWeb" BeforeTargets="Build">
    <ItemGroup>
      <_StudioWeb Include="$(MSBuildProjectDirectory)\..\..\web\dist\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StudioWeb)"
          DestinationFiles="@(_StudioWeb->'$(OutDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
